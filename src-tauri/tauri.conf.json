{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudioCut AI",
  "version": "0.1.0",
  "identifier": "app.studiocut.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StudioCut AI",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost https://asset.localhost blob:; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "targets": [
      "deb",
      "nsis",
      "msi",
      "dmg"
    ],
    "shortDescription": "Local-first video editing workspace",
    "category": "Video",
    "icon": [],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxOEU1RDY0MUZFQjgzOEYKUldTUGcrc2ZaRjJPNFhPY3FDYmdGQnp4NTFDM08ySWJDVEx0TnZMcGRvaVBCNjBNb01PN2piVXcK",
      "endpoints": [
        "https://github.com/alphaframehq/studiocut-ai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
